{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nvnmvm/crypto-strategy-analyst/schemas/analysis-report.schema.json",
  "title": "Crypto Strategy Analyst report 3.0",
  "type": "object",
  "required": ["schema_version", "report_id", "symbol", "profile", "profile_confidence", "generated_at", "evaluation_time", "market", "data_availability", "scores", "confidence", "key_levels", "relative_strength", "horizons", "events", "warnings", "limitations", "hard_filters"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "report_id": {"type": "string", "minLength": 8},
    "symbol": {"type": "string"},
    "profile": {"enum": ["btc", "eth", "bnb", "sol", "generic"]},
    "profile_confidence": {"enum": ["dedicated", "limited"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "evaluation_time": {"type": "string", "format": "date-time"},
    "market": {"type": "object", "required": ["regime", "volatility", "liquidity"]},
    "data_availability": {"type": "object"},
    "scores": {
      "type": "object",
      "required": ["technical", "derivatives", "onchain", "macro", "relative_strength", "asset_specific", "data_completeness", "confidence"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 100},
    "key_levels": {
      "type": "object",
      "required": ["supports", "resistances"],
      "properties": {"supports": {"type": "array"}, "resistances": {"type": "array"}}
    },
    "relative_strength": {"type": "object"},
    "horizons": {
      "type": "object",
      "minProperties": 1,
      "properties": {"short": {"type": "object"}, "swing": {"type": "object"}, "long": {"type": "object"}}
    },
    "events": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "hard_filters": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
